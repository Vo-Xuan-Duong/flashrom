{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashROM",
  "version": "0.1.0",
  "identifier": "com.voxuanduong.flashrom",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlashROM",
        "width": 1100,
        "height": 760,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
